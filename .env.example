# Copy to .env.local (gitignored) and fill in. Without any of these the game
# asks the player to log in with MRX (OAuth), like the published version.

# LOCAL TESTING ONLY: skips the login. The key is compiled into the JS bundle
# and readable by anyone who loads the page - never set it in CI.
VITE_MRX_API_KEY=

# Offline mock simulation, no MRX at all.
# VITE_MRX_MOCK=true

# Optional, defaults to the public MRX gateway.
# VITE_MRX_URL=https://mrx-org--mcp-gateway-func.modal.run/mcp
